# MongoDB (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/smartpathai

# Session cookie signing (do not use the insecure fallback in shared environments)
SESSION_SECRET=change-me

# Google OAuth (Passport). Callback URI must match Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
SERVER_PUBLIC_URL=http://localhost:4000
CLIENT_URL=http://localhost:5173
# Exact frontend origins (no trailing slash). For a shared GCP backend, include
# both your production Vercel origin and http://localhost:5173 in BOTH lists.
AUTH_ALLOWED_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Node-side answer grading (gpt-4o-mini)
OPENAI_API_KEY=

# Sibling FastAPI AI server
PYTHON_SERVICE_URL=http://127.0.0.1:8000

PORT=4000
# NODE_ENV=development
